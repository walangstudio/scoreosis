{
  "name": "scoreosis",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Verified multi-game leaderboards and achievements on Cloudflare Workers.",
  "scripts": {
    "build:vm": "node tools/build-vm.mjs",
    "pack:games": "node tools/pack-game.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@walangstudio/badgetrip-core": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@walangstudio/badgetrip-testing": "0.1.0",
    "typescript": "5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "packageManager": "pnpm@11.3.0",
  "license": "MIT"
}
