{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scoreosis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "rules": [{ "type": "Text", "globs": ["**/*.lua"], "fallthrough": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // Lua instructions the verifier may spend per request (~116k per ms measured locally).
    "VERIFY_INSTRUCTIONS": "1000000",
    "MAX_RUNS_PER_DAY": "750",
    "ALLOWED_ORIGINS": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAYERS", "class_name": "PlayerSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayerSession"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoreosis-dev",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "GUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],
  "env": {
    "staging": {
      "routes": [{ "pattern": "scoreosis-staging.walang.studio", "custom_domain": true }],
      "vars": {
        "VERIFY_INSTRUCTIONS": "1000000",
        "MAX_RUNS_PER_DAY": "500",
        "ALLOWED_ORIGINS": "http://127.0.0.1:8774,http://127.0.0.1:8775,http://localhost:8774,http://localhost:8775,http://127.0.0.1:8097,http://localhost:8097,https://html-classic.itch.zone"
      },
      "durable_objects": { "bindings": [{ "name": "PLAYERS", "class_name": "PlayerSession" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scoreosis-staging",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "GUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "IP_LIMITER", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
      ]
    },
    "production": {
      "routes": [{ "pattern": "scoreosis.walang.studio", "custom_domain": true }],
      "vars": {
        "VERIFY_INSTRUCTIONS": "1000000",
        "MAX_RUNS_PER_DAY": "750",
        "ALLOWED_ORIGINS": "https://html-classic.itch.zone"
      },
      "durable_objects": { "bindings": [{ "name": "PLAYERS", "class_name": "PlayerSession" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scoreosis-production",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "GUEST_LIMITER", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
        { "name": "IP_LIMITER", "namespace_id": "3003", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
